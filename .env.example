# ==============================================================================
# VocabForest Environment Variables
# ==============================================================================

# Vercel Blob Cloud Storage (Auto-generated by Vercel when connecting a Blob store)
# In Vercel Dashboard: Project -> Storage -> Connect Store -> Blob -> Create
BLOB_READ_WRITE_TOKEN=

# MongoDB Connection String (Alternative cloud option: Atlas free M0 cluster)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Optional: MongoDB Database name (defaults to 'vocabforest' if omitted)
MONGODB_DB_NAME=vocabforest
